def calculate_cube_root(number):
  """Calculates the cube root of a given number.

  Args:
    number: The number for which to calculate the cube root.

  Returns:
    The cube root of the number.
  """
  return number**(1/3)

# Example usage:
num1 = 27
cube_root1 = calculate_cube_root(num1)
print(f"The cube root of {num1} is: {cube_root1}")

num2 = 64
cube_root2 = calculate_cube_root(num2)
print(f"The cube root of {num2} is: {cube_root2}")

num3 = -8
cube_root3 = calculate_cube_root(num3)
print(f"The cube root of {num3} is: {cube_root3}")
